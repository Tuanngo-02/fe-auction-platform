# Tên ứng dụng hiển thị trên tiêu đề tab
VITE_APP_NAME=Đấu giá trực tuyến

# Base URL mà axios dùng. Khi dev để /api (đi qua proxy của Vite).
# Khi build production trỏ thẳng tới backend, ví dụ https://api.example.com/api
VITE_APP_API_URL=/api

# Địa chỉ backend Spring Boot mà proxy của Vite chuyển tiếp tới (chỉ dùng khi dev)
VITE_APP_BACKEND_URL=http://localhost:8080
